# -----------------------------------------------------------------------
# US Expat Tax Helper – Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
# -----------------------------------------------------------------------

# --- HashiCorp Vault ---------------------------------------------------
VAULT_ADDR=https://vault:8200
# AppRole credentials (written to /run/secrets/ in production)
# VAULT_ROLE_ID=<from vault write auth/approle/role/erica-service/role-id>
# VAULT_SECRET_ID=<from vault write -f auth/approle/role/erica-service/secret-id>

# --- Erica / ELSTER ----------------------------------------------------
ERICA_SERVICE_URL=https://erica-service:8443
# Path to the ELSTER organisation certificate (.pfx) rendered by vault-agent
ERIC_CERT_PATH=/run/secrets/eric-cert/organisation.pfx
# Set to "true" when the cert sink is a tmpfs mount (required in production)
ERIC_CERT_TMPFS=true

# Vault certificate boot-wait tuning (erica-service entrypoint)
VAULT_CERT_WAIT_MAX_RETRIES=10
VAULT_CERT_WAIT_BASE_DELAY_S=1.0
VAULT_CERT_WAIT_MAX_DELAY_S=60.0

# --- Database ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/expat_tax

# --- Tink PSD2 API (read-only bank data) -------------------------------
# The access token is obtained via OAuth and passed per-request at runtime.
# These values are used during the OAuth flow / token exchange.
TINK_CLIENT_ID=your-tink-client-id
TINK_CLIENT_SECRET=your-tink-client-secret
TINK_API_BASE=https://api.tink.com/data/v2

# --- Application -------------------------------------------------------
TZ=Europe/Berlin
LOG_LEVEL=INFO

# --- JWT Mandanten-Authentifizierung -----------------------------------
# WICHTIG: SECRET_KEY in Produktion durch sicheren Zufallswert ersetzen!
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-prod
ALGORITHM=HS256
